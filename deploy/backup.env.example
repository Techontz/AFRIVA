# Backup credentials. Copy to /srv/afriva/secrets/backup.env (owner deploy, mode 600). Never commit.
# Kept apart from the Laravel .env so a compromised app cannot read or delete backups.
#
# Cloudflare dashboard > R2 > Manage API tokens > Create token:
#   permission "Object Read & Write", applied to the backup bucket ONLY.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=afriva-backups
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
