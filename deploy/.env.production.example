# Afriva API: production environment template.
#
# Copy to the server as /srv/afriva/shared/.env (owner deploy, mode 600) and fill in the values there.
# NEVER commit the filled file. This file is read by:
#   - Laravel (mounted read-only into the app, worker and scheduler containers as /var/www/html/.env)
#   - Docker Compose (--env-file) for DB_*, REDIS_PASSWORD and MYSQL_ROOT_PASSWORD
# Generate passwords and keys with: openssl rand -hex 32   (hex only: no quotes, $ or # to escape)
# After editing: deploy/scripts/compose.sh up -d --force-recreate app worker scheduler

# ---- Application ---------------------------------------------------------
APP_NAME=Afriva
APP_ENV=production
# Generate once: docker compose run --rm -e AFRIVA_OPTIMIZE=0 app php artisan key:generate --show
APP_KEY=
# Comma separated old keys, only while rotating APP_KEY.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://api.afriva.co.tz
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=
BCRYPT_ROUNDS=12
# Shown by GET /api/v1/health. APP_COMMIT is set automatically by Compose from the deployed image tag;
# leave it empty here. APP_VERSION is an optional human label (e.g. 1.4.0).
APP_VERSION=
APP_COMMIT=

# ---- Logging -------------------------------------------------------------
# Daily files in /srv/afriva/shared/storage/logs, kept LOG_DAILY_DAYS days.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=
LOG_SLACK_EMOJI=
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=
LOG_PAPERTRAIL_HANDLER=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

# ---- Database (MySQL container "mysql") ----------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=afriva
# Not "root". Compose creates this user on the first start of an empty volume.
DB_USERNAME=afriva
DB_PASSWORD=
DB_SOCKET=
DB_URL=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=
# Compose only (MySQL container root password; used by backups and restores, never by Laravel).
MYSQL_ROOT_PASSWORD=

# ---- Redis (container "redis") -------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
# Required: Redis refuses to start without it (requirepass).
REDIS_PASSWORD=
REDIS_URL=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=afriva_database_
REDIS_PERSISTENT=false
REDIS_CLUSTER=redis
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=180

# ---- Cache, queue, session -----------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=afriva_cache_
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
# The API is token based (Sanctum bearer tokens): no server sessions needed.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log
# Rate limiter store; empty = CACHE_STORE (Redis).
RATE_LIMITER_STORE=

# ---- HTTP: CORS, proxies, Sanctum ----------------------------------------
CORS_ALLOWED_ORIGINS=https://afriva.co.tz,https://www.afriva.co.tz,https://admin.afriva.co.tz,https://studio.afriva.co.tz
# Leave EMPTY. Nginx talks FastCGI to PHP and already passes the real client IP (from Cloudflare's
# CF-Connecting-IP, only trusted from Cloudflare ranges) as REMOTE_ADDR. Setting * here would let
# clients spoof their IP with X-Forwarded-For.
TRUSTED_PROXIES=
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

# ---- Files ---------------------------------------------------------------
# "public" = local disk in /srv/afriva/shared/storage/app/public (served by Nginx at /storage/).
# Switch to the R2 disk name the app defines (planned: r2_public) after the R2 migration.
FILESYSTEM_DISK=public
# Disk for posters, banners, logos, avatars: "public" (local, before migration) or "r2_public".
MEDIA_DISK=public
# Disk for creator ID documents: "local" (before migration) or "r2_private" (signed, expiring URLs).
PRIVATE_DOCUMENTS_DISK=local
PRIVATE_DOCUMENT_URL_TTL_MINUTES=10
# Optional CDN in front of public files (the Bunny pull zone today, media.afriva.co.tz with R2).
MEDIA_CDN_URL=

# ---- Cloudflare R2 (S3 API) ----------------------------------------------
# Token scoped to the public and private media buckets only (Object Read and Write).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PUBLIC_BUCKET=afriva-media
R2_PRIVATE_BUCKET=afriva-private
# Public URL of the public bucket (custom domain), e.g. https://media.afriva.co.tz
R2_PUBLIC_URL=
# Backup bucket name (informational for the admin Infrastructure page). Backup credentials are NOT
# kept here; they live in /srv/afriva/secrets/backup.env so the app cannot read or delete backups.
R2_BACKUP_BUCKET=afriva-backups
# Legacy S3 variables of config/filesystems.php ("s3" disk). Unused in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Mail ----------------------------------------------------------------
# smtp (any provider), resend, postmark, or log. MAIL_URL overrides the separate fields.
MAIL_MAILER=smtp
MAIL_URL=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=support@afriva.co.tz
MAIL_FROM_NAME=Afriva
MAIL_LOG_CHANNEL=
MAIL_SENDMAIL_PATH=
RESEND_API_KEY=
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# ---- First admin (only for the first "php artisan db:seed --force") --------
# Clear ADMIN_PASSWORD right after seeding.
ADMIN_NAME="Afriva Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Payments (no gateway connected yet; checkout shows "Coming soon") ----
# Must be false in production.
PAYMENTS_SANDBOX_AUTO_APPROVE=false
PAYMENTS_SANDBOX_CALLBACKS=false
PAYMENTS_CALLBACK_URL=https://api.afriva.co.tz/api/v1/payments/callback
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_BASE_URL=
TIGOPESA_CLIENT_ID=
TIGOPESA_CLIENT_SECRET=
TIGOPESA_BILLER_MSISDN=
TIGOPESA_BASE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=
HALOPESA_API_KEY=
HALOPESA_MERCHANT_ID=
HALOPESA_BASE_URL=
CARD_PROVIDER=dpo
CARD_API_KEY=
CARD_SECRET_KEY=
CARD_BASE_URL=
BANK_PROVIDER=selcom
BANK_API_KEY=
BANK_SECRET_KEY=
BANK_BASE_URL=

# ---- Bunny Stream (episode videos) ---------------------------------------
BUNNY_STREAM_LIBRARY_ID=
# Library API key (Stream > library > API). Server only.
BUNNY_STREAM_API_KEY=
# e.g. vz-xxxxxxxx-xxx.b-cdn.net (no https://)
BUNNY_STREAM_CDN_HOSTNAME=
# Library > Security > CDN token authentication key. Set it in production so playback URLs are signed.
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_TOKEN_TTL=14400
BUNNY_STREAM_PROTECTED_VIDEOS=
BUNNY_STREAM_SHOWCASE_VIDEO=
# The library's Read-Only API key. Set it in production so webhook signatures are checked.
BUNNY_STREAM_WEBHOOK_SECRET=

# ---- Infrastructure page and budget alerts (admin) -------------------------
# Read-only tokens used by the admin Infrastructure page. Leave empty to hide that figure.
INFRA_MONTHLY_BUDGET_USD=
INFRA_ALERT_EMAIL=
# Hetzner Cloud: project > Security > API tokens, permission "Read".
HETZNER_API_TOKEN=
# Numeric id of the server (Hetzner console URL or: hcloud server list).
HETZNER_SERVER_ID=
# Cloudflare: token with "Account Analytics: Read" and "Workers R2 Storage: Read" only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Bunny account API key (Account > API). It can manage the whole account: keep it server only.
BUNNY_ACCOUNT_API_KEY=
# Optional tuning of the Infrastructure page (defaults in backend/config/infra.php). All prices are
# editable ESTIMATES, not billed amounts.
INFRA_CACHE_TTL=600
INFRA_HTTP_TIMEOUT=8
INFRA_ERROR_ALERTS=true
INFRA_ERROR_ALERT_THROTTLE_MINUTES=10
INFRA_EUR_TO_USD=1.08
INFRA_HETZNER_MONTHLY_EUR=8.99
INFRA_HETZNER_BACKUPS=true
INFRA_BUNNY_STORAGE_USD_PER_GB=0.01
INFRA_BUNNY_STORAGE_REGIONS=1
INFRA_BUNNY_BANDWIDTH_USD_PER_GB=0.06
INFRA_VERCEL_MONTHLY_USD=20

# ---- Compose and deploy (not read by Laravel) ------------------------------
# uid/gid of the deploy user; the image's "afriva" user is built with the same ids.
AFRIVA_UID=1000
AFRIVA_GID=1000
AFRIVA_ROOT=/srv/afriva
