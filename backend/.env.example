APP_NAME=Afriva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Shared host: "single". Production in Docker: "daily,stderr" (daily files kept LOG_DAILY_DAYS days, plus the
# container log for `docker logs`). LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter gives one JSON line per entry.
LOG_STACK=single
# LOG_DAILY_DAYS=14
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afriva
DB_USERNAME=root
DB_PASSWORD=

# The API is token based (Sanctum bearer tokens) and the "/" index skips the session middleware, so nothing
# needs persistent sessions. "array" keeps the database out of every request (use "file" if you add web pages).
# Keep "array" on the new server too: Redis is not needed for sessions because the API never stores any.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# No queued jobs exist yet; "sync" needs no worker and no jobs table polling.
QUEUE_CONNECTION=sync

# The rate limiter and the public catalogue cache hit the cache store on every request: never use "database"
# here in production. "file" is fast on a single server; switch to "redis" if it is available.
CACHE_STORE=file
# CACHE_PREFIX=
# Rate limiter store; empty = CACHE_STORE (so CACHE_STORE=redis also puts rate limiting on Redis).
# RATE_LIMITER_STORE=
# Production (Hetzner, Docker with the phpredis extension): CACHE_STORE=redis, QUEUE_CONNECTION=redis,
# REDIS_CLIENT=phpredis, REDIS_HOST=redis, REDIS_PASSWORD=<secret>. The shared host keeps file/sync, no Redis needed.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Afriva -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reverse proxies / load balancers whose X-Forwarded-* headers are trusted (comma separated, or *).
TRUSTED_PROXIES=

# Production only: `php artisan db:seed` creates this super admin instead of the demo accounts.
ADMIN_NAME="Afriva Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments: while true, every non-integrated method is approved instantly by the SandboxGateway (demo mode).
PAYMENTS_SANDBOX_AUTO_APPROVE=true
# Allow POST /payments/callback/sandbox to settle sandbox payments by hand (defaults to off when APP_ENV=production).
# PAYMENTS_SANDBOX_CALLBACKS=true
PAYMENTS_CALLBACK_URL="${APP_URL}/api/v1/payments/callback"

# M-Pesa (Vodacom Tanzania OpenAPI)
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_BASE_URL=https://openapi.m-pesa.com/sandbox
# Mixx by Yas / Tigo Pesa
TIGOPESA_CLIENT_ID=
TIGOPESA_CLIENT_SECRET=
TIGOPESA_BILLER_MSISDN=
TIGOPESA_BASE_URL=
# Airtel Money
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
# HaloPesa
HALOPESA_API_KEY=
HALOPESA_MERCHANT_ID=
HALOPESA_BASE_URL=
# Cards (Visa / Mastercard) via dpo|flutterwave|selcom
CARD_PROVIDER=dpo
CARD_API_KEY=
CARD_SECRET_KEY=
CARD_BASE_URL=
# Banks (CRDB, NMB, NBC) and T-Pesa via aggregator
BANK_PROVIDER=selcom
BANK_API_KEY=
BANK_SECRET_KEY=
BANK_BASE_URL=

# --- Bunny Stream (episode videos) ---------------------------------------
# Library ID and API key: Stream > your library > API. The API key stays on the server (never sent to clients).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# CDN hostname of the library, without https:// (Stream > your library > API > CDN hostname), e.g. vz-xxxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# Optional. Library > Security > CDN token authentication key. Empty = playback URLs are not signed.
BUNNY_STREAM_TOKEN_KEY=
# Lifetime of signed playback URLs in seconds (default 4 hours).
BUNNY_STREAM_TOKEN_TTL=14400
# Comma-separated Bunny video ids shared by many episodes; never deleted with an episode or drama.
BUNNY_STREAM_PROTECTED_VIDEOS=
# Bunny video id every showcase demo episode plays (php artisan db:seed --class=ShowcaseSeeder).
BUNNY_STREAM_SHOWCASE_VIDEO=
# Optional Bunny pull zone in front of this API's public files (posters, uploads).
MEDIA_CDN_URL=
# Optional. The library's Read-Only API key; when set, webhook requests must have a valid signature.
BUNNY_STREAM_WEBHOOK_SECRET=

# --- Build info (shown by GET /api/v1/health; set by the deploy, never secrets) ----------------------------
APP_VERSION=
APP_COMMIT=

# --- Media storage (Cloudflare R2, S3 compatible) ---------------------------------------------------------
# Defaults keep files on this server: MEDIA_DISK=public (posters, backdrops, thumbnails, logos, avatars) and
# PRIVATE_DOCUMENTS_DISK=local (creator ID documents). On R2: MEDIA_DISK=r2_public, PRIVATE_DOCUMENTS_DISK=r2_private,
# after copying the existing files with `php artisan media:migrate-to-r2 --dry-run` then without --dry-run.
MEDIA_DISK=public
PRIVATE_DOCUMENTS_DISK=local
# Signed links to private documents on R2 expire after this many minutes.
PRIVATE_DOCUMENT_URL_TTL_MINUTES=10
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# Custom domain of the public bucket, e.g. https://media.afriva.co.tz (no trailing slash)
R2_PUBLIC_URL=
# Optional: the backup bucket, only listed on the admin Infrastructure page.
R2_BACKUP_BUCKET=

# --- Alerts (free: email only, no paid error service) -------------------------------------------------------
# Receives budget alerts and, when a real mailer is set (MAIL_MAILER not log/array), one email per error type
# per INFRA_ERROR_ALERT_THROTTLE_MINUTES. Empty = no error emails; budget emails go to the support_email setting.
INFRA_ALERT_EMAIL=
# INFRA_ERROR_ALERTS=true
# INFRA_ERROR_ALERT_THROTTLE_MINUTES=10

# --- Infrastructure dashboard (admin > Infrastructure). Every provider is optional. --------------------------
# Monthly budget in USD for the 50/75/90/100% emails (the admin Settings value overrides it).
INFRA_MONTHLY_BUDGET_USD=
# INFRA_CACHE_TTL=600
# Hetzner Cloud: a READ-ONLY project API token and the server's numeric id.
HETZNER_API_TOKEN=
HETZNER_SERVER_ID=
# Bunny account API key (storage, bandwidth, billing). The Stream library key above only gives the video count.
BUNNY_ACCOUNT_API_KEY=
# Cloudflare API token with Account Analytics Read and Workers R2 Storage Read, and the account id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Editable cost estimates (see config/infra.php for all unit prices).
# INFRA_EUR_TO_USD=1.08
# INFRA_HETZNER_MONTHLY_EUR=8.99
# INFRA_HETZNER_BACKUPS=true
# INFRA_VERCEL_MONTHLY_USD=20
# INFRA_BUNNY_BANDWIDTH_USD_PER_GB=0.06
# INFRA_BUNNY_STORAGE_USD_PER_GB=0.01
# INFRA_BUNNY_STORAGE_REGIONS=1
