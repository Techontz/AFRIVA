APP_NAME=Afriva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afriva
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Afriva -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payments: while true, every non-integrated method is approved instantly by the SandboxGateway (demo mode).
PAYMENTS_SANDBOX_AUTO_APPROVE=true
PAYMENTS_CALLBACK_URL="${APP_URL}/api/v1/payments/callback"

# M-Pesa (Vodacom Tanzania OpenAPI)
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_BASE_URL=https://openapi.m-pesa.com/sandbox
# Mixx by Yas / Tigo Pesa
TIGOPESA_CLIENT_ID=
TIGOPESA_CLIENT_SECRET=
TIGOPESA_BILLER_MSISDN=
TIGOPESA_BASE_URL=
# Airtel Money
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
# HaloPesa
HALOPESA_API_KEY=
HALOPESA_MERCHANT_ID=
HALOPESA_BASE_URL=
# Cards (Visa / Mastercard) via dpo|flutterwave|selcom
CARD_PROVIDER=dpo
CARD_API_KEY=
CARD_SECRET_KEY=
CARD_BASE_URL=
# Banks (CRDB, NMB, NBC) and T-Pesa via aggregator
BANK_PROVIDER=selcom
BANK_API_KEY=
BANK_SECRET_KEY=
BANK_BASE_URL=
