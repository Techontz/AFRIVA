# Nightly encrypted database backup to R2 (deploy/scripts/backup-db.sh).
# Install: cp to /etc/systemd/system/, then: systemctl daemon-reload && systemctl enable --now afriva-backup.timer
# Run now: sudo systemctl start afriva-backup.service ; logs: journalctl -u afriva-backup.service
[Unit]
Description=Afriva nightly database backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/srv/afriva/repo/deploy/scripts/backup-db.sh --label nightly
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
