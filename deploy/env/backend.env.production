APP_NAME=Afriva
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__API_DOMAIN__

APP_LOCALE=sw
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afriva
DB_USERNAME=afriva
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@__WEB_DOMAIN__"
MAIL_FROM_NAME="${APP_NAME}"

# --- Afriva -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://__WEB_DOMAIN__,https://www.__WEB_DOMAIN__

# Videos: private disk, signed URLs, served by Nginx (see config/media.php).
VIDEO_DELIVERY=x-accel
VIDEO_URL_TTL_MINUTES=360
# Encode uploads to HLS 480p/720p/1080p with ffmpeg in the queue worker (scope §08).
MEDIA_TRANSCODE=true
# Longer than the transcode timeout, or a long encode would be picked up a second time.
DB_QUEUE_RETRY_AFTER=3900

# MUST stay false in production: true approves every payment without charging anyone.
# With no real provider connected yet, checkouts stay "pending".
PAYMENTS_SANDBOX_AUTO_APPROVE=false
# Never true in production: the sandbox webhook can mark any payment as paid.
PAYMENTS_SANDBOX_ENABLED=false
PAYMENTS_CALLBACK_URL="${APP_URL}/api/v1/payments/callback"

# Payment provider credentials (fill in when each provider is connected)
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_BASE_URL=https://openapi.m-pesa.com/sandbox
TIGOPESA_CLIENT_ID=
TIGOPESA_CLIENT_SECRET=
TIGOPESA_BILLER_MSISDN=
TIGOPESA_BASE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
HALOPESA_API_KEY=
HALOPESA_MERCHANT_ID=
HALOPESA_BASE_URL=
CARD_PROVIDER=dpo
CARD_API_KEY=
CARD_SECRET_KEY=
CARD_BASE_URL=
BANK_PROVIDER=selcom
BANK_API_KEY=
BANK_SECRET_KEY=
BANK_BASE_URL=
