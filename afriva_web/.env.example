# Base URL of the Afriva Laravel API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public URL of this website (used for absolute Open Graph URLs), e.g. https://afriva.co.tz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: serve Admin and Studio on their own hosts (production)
# NEXT_PUBLIC_ADMIN_URL=https://admin.afriva.co.tz
# NEXT_PUBLIC_STUDIO_URL=https://studio.afriva.co.tz

# Optional: Google OAuth web client id for "Continue with Google". Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
